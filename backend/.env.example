# Base URL for the OSRM routing service (the public demo server works for development).
OSRM_BASE_URL=https://router.project-osrm.org

# Base URL for the Nominatim geocoding service.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Django runtime settings.
# Local defaults keep `python manage.py runserver` working out of the box.
# On Render (or any host), set these explicitly for the deployed service.
SECRET_KEY=django-insecure-change-me-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to call the API.
# Local Vite default:
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Temporary first-deploy escape hatch (set false once the real frontend origin is known):
CORS_ALLOW_ALL=False
